{
  "uid": "razin-trps-ivl",
  "title": "ИВЛ — мониторинг | Разин Д.Д. | семинары ТРПС 7–8",
  "tags": [
    "razin",
    "trps",
    "ivl"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Записей лога в хранилище",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "ivl_logs_stored",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Запросов в секунду (1 мин)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "sum(rate(ivl_http_requests_total[1m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Сработавших алертов (всего)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "sum(ivl_alert_events_total) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Запросов в обработке",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "ivl_http_requests_in_progress",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Запросы по маршрутам (RPS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "sum by (method, path) (rate(ivl_http_requests_total[1m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Время ответа p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ivl_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ivl_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Принято логов по уровням",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "sum by (level) (ivl_logs_ingested_total)",
          "legendFormat": "{{level}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Ответы 4xx / 5xx (RPS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ivl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ivl-prometheus"
          },
          "expr": "sum by (status) (rate(ivl_http_requests_total{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}